{
  "compilerOptions": {
    "composite": true,

    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],

    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "rootDir": "src",
    "outDir": "dist-ts/app",
    "declaration": true,
    "sourceMap": false,

    "strict": true,
    "skipLibCheck": true,

    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"]
    },

    "rootDir": "src",
    "outDir": "dist-ts/app",
    "sourceMap": false
  },
  "include": ["src"],
  "exclude": ["node_modules", "dist-ts", "@"]
}
